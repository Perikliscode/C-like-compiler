static char *kid[N]={"and","else","if","int","not","or","while","break","true","false","return"};
static int kval[N]={AND,ELSE,IF,INT,NOT,OR,WHILE,BREAK,TRUE,FALSE,RETURN};

int id_or_keyword(char *s)
{  int i,k;

   for(i=0; (i < N) && (strcmp(s,kid[i]) != 0); i++);
   if(i < N)
      return kval[i];
   else
      return ID;
}
